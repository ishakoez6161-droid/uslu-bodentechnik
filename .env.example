# Google-Bewertungen (Google Places API, "Places API (New)")
# Place ID des Google-Unternehmensprofils, z. B. über
# https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
# API-Schlüssel aus der Google Cloud Console mit aktivierter "Places API (New)"
GOOGLE_PLACES_API_KEY=
# Optional: direkter Link zum Unternehmensprofil (überschreibt den automatisch erzeugten Link)
GOOGLE_REVIEWS_URL=
